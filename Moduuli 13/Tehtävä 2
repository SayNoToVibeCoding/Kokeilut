DATABASE_FILE = 'testi.sql'

def get_airport_by_icao(icao_code):
    """Hakee lentokentän tiedot SQLite-tietokannasta ICAO-koodin perusteella."""
    connection = None
    try:
        connection = sqlite3.connect(DATABASE_FILE)
        
        connection.row_factory = sqlite3.Row
        cursor = connection.cursor()
        
        sql = "SELECT ident, name, municipality FROM airport WHERE ident = ?"
        cursor.execute(sql, (icao_code.upper(),))
        result = cursor.fetchone()
        
        return result
    except sqlite3.Error as err:
        print(f"Tietokantavirhe: {err}")
        return None
    finally:
        if connection:
            connection.close()


@app.route('/kenttä/<string:icao>', methods=['GET'])
def get_airport(icao):
    airport_data = get_airport_by_icao(icao)
    
    if not airport_data:
        return jsonify({"error": f"Lentokenttää koodilla {icao} ei löytynyt."}), 404
    
    response = {
        "ICAO": airport_data['ident'],
        "Name": airport_data['name'],
        "Municipality": airport_data['municipality']
    }
    
    return jsonify(response)

if __name__ == '__main__':
    app.run(host='127.0.0.1', port=3000, debug=True)